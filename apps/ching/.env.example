# Copy to .env.local (gitignored) for local dev, or set in Vercel for production.
# The dev API runner (dev/vite-plugin-dev-api.ts) loads these into process.env.

# Anthropic key for the Full Cast dialogue. Same variable soul uses.
ANTHROPIC_API_KEY=

# Full Cast closed-beta access code (mirrors soul's DEEPDIVE_PASSCODE gate).
# Unset = Full Cast is closed: ching-unlock and ching-dialogue both answer 503.
CHING_PASSCODE=

# Dialogue model. Default claude-sonnet-5-5; claude-haiku-5-5 is the cheaper option.
# CHING_MODEL=claude-sonnet-5-5

# Usage limits (BUILD.md §6.3). If ANY of these is unset, the dialogue fails closed (503).
CHING_MAX_MESSAGES_PER_READING=
CHING_MAX_READINGS_PER_UNLOCK=
CHING_DAILY_TOKEN_CAP=

# Usage counters live in Supabase, as soul's data does (tables: supabase/ching.sql).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local dev only: keep the usage counters in memory instead of Supabase.
# Ignored on Vercel (VERCEL is set there), so it can never weaken production.
# CHING_DEV_MEMORY_STORE=1
